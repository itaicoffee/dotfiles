#!/usr/bin/env python3
import ctypes
from ctypes import c_char_p, c_void_p, c_uint32

hi = ctypes.CDLL(
    "/System/Library/Frameworks/ApplicationServices.framework/Frameworks/HIServices.framework/HIServices"
)
cf = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
cf.CFStringCreateWithCString.argtypes = [c_void_p, c_char_p, c_uint32]
cf.CFStringCreateWithCString.restype = c_void_p
hi.CoreDockSendNotification.argtypes = [c_void_p]
hi.CoreDockSendNotification.restype = None

name = cf.CFStringCreateWithCString(None, b"com.apple.showdesktop.awake", 0x08000100)
hi.CoreDockSendNotification(name)
