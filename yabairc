#!/usr/bin/env sh
# layout & feel
yabai -m config layout           bsp
yabai -m config window_gap       8
yabai -m config top_padding      8
yabai -m config bottom_padding   8
yabai -m config left_padding     8
yabai -m config right_padding    8
yabai -m config auto_balance     on

# mouse helpers
yabai -m config mouse_modifier   alt
yabai -m config mouse_action1    move
yabai -m config mouse_action2    resize

# float rules (tune these for your stack)
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^App Store$"       manage=off
yabai -m rule --add app="^Zoom$"            manage=off
yabai -m rule --add app="^Simulator$"       manage=off
yabai -m rule --add app="^Photos$"          manage=off
yabai -m rule --add app="^Calendar$" title=".*" manage=off

# Label available spaces and route apps by role. Missing spaces are skipped so
# the config remains valid on machines with fewer than five macOS spaces.
route_app_to_space() {
    if yabai -m query --spaces --space "$1" >/dev/null 2>&1; then
        yabai -m space "$1" --label "$2"
        yabai -m rule --add app="$3" space="$2"
    fi
}

route_app_to_space 1 dev   '^Xcode$'
route_app_to_space 2 term  '^(Ghostty|Kitty|iTerm2|Terminal)$'
route_app_to_space 3 web   '^(Arc|Google Chrome|Firefox|Safari)$'
route_app_to_space 4 comms '^(Slack|Discord|Messages)$'
route_app_to_space 5 docs  '^(Notion|Obsidian|Preview)$'
